# Python caches
__pycache__/
*.pyc

# Downloaded third-party files. data/<analysis>/raw/ keeps only its README.md
# and the paper's manifest.json in the repository.
data/*/raw/*
!data/*/raw/README.md
!data/*/raw/manifest.json
data/*/raw/.manifest.lock
*.part

# Copies of the paper's manifests and outputs, kept for comparison
data/*/manifest.paper.json
data/*/derived.paper/
data/*/derived-rerun/

# Temporary clones and logs
.tmp_*/
*.log

# Outputs that the scripts write but the repository does not include
figures_check/
figures/robust.pdf
simulations/figures_exact/
data/*/derived/doc_text/
data/burn_units/derived/ooni_platform_domains.csv
data/burn_units/derived/cn_gfwlist_platform_line_events.csv
data/burn_units/derived/ooni_raw_mechanism_checks.csv
data/burn_units/derived/fig_burn_units_timeline.pdf
data/snowflake/derived/rdsys_*.csv
data/snowflake/derived/shutdown_day_masks.csv
data/snowflake/derived/ioda_long_events_not_used_in_primary_mask.csv
data/snowflake/derived/timeline_snowflake_related.csv
data/snowflake/derived/fig_snowflake*
data/minting/derived/porkbun_tld_prices.csv
data/minting/derived/ct_log_list_summary.csv
data/minting/derived/fig_exposure_delays.pdf
